<?xml version="1.0"?>
<!DOCTYPE benchmark PUBLIC "+//IDN sosy-lab.org//DTD BenchExec benchmark 2.3//EN" "https://www.sosy-lab.org/benchexec/benchmark-2.3.dtd">
<!-- <benchmark tool="goblint" displayName="Goblint" timelimit="60 s" hardtimelimit="66 s" memlimit="1 GB" cpuCores="1"> -->
<benchmark tool="goblint" displayName="Goblint" timelimit="15 min" hardtimelimit="16 min" memlimit="5 GB" cpuCores="1">
<!-- <benchmark tool="goblint" displayName="Goblint" timelimit="15 min" hardtimelimit="16 min" memlimit="15 GB" cpuCores="4"> -->
<!-- <benchmark tool="goblint" displayName="Goblint" timelimit="2 h" hardtimelimit="7300 s" memlimit="24 GB" cpuCores="8"> -->

  <resultfiles></resultfiles>

  <option name="--enable">ana.sv-comp.enabled</option>
  <option name="--enable">ana.sv-comp.functions</option> <!-- for SvComp-Pthread.set -->

  <!-- for Concrat -->
  <option name="--set">lib.activated[+]</option>
  <option>zlib</option>
  <option name="--set">lib.activated[+]</option>
  <option>pcre</option>
  <option name="--set">lib.activated[+]</option>
  <option>liblzma</option>

  <option>-v</option> <!-- for evals and vars columns -->

  <rundefinition name="td3">
    <option name="--set">solver</option>
    <option>td3</option>
  </rundefinition>

  <rundefinition name="td3_o_cwnw">
    <option name="--set">solver</option>
    <option>td3</option>
    <option name="--enable">solvers.td3.narrow-globs.enabled</option>
    <option name="--set">solvers.td3.side_widen_gas</option>
    <option>2</option>
    <option name="--set">solvers.td3.widen_gas</option>
    <option>2</option>
    <option name="--enable">solvers.td3.narrow-globs.eliminate-dead</option>
    <option name="--set">solvers.td3.narrow-globs.narrow-gas</option>
    <option>-1</option>
  </rundefinition>

  <rundefinition name="slr3">
    <option name="--set">solver</option>
    <option>slr3</option>
  </rundefinition>

  <rundefinition name="qss_cwnw">
    <option name="--set">solver</option>
    <option>qss_cwnw</option>
  </rundefinition>

  <rundefinition name="qss_cwnw_w">
    <option name="--set">solver</option>
    <option>qss_cwnw_w</option>
  </rundefinition>

  <rundefinition name="qsr">
    <option name="--set">solver</option>
    <option>qsr</option>
  </rundefinition>

  <rundefinition name="qsr_dead">
    <option name="--set">solver</option>
    <option>qsr_dead</option>
  </rundefinition>

  <rundefinition name="qsr_nosides">
    <option name="--set">solver</option>
    <option>qsr_nosides</option>
  </rundefinition>

  <rundefinition name="qsr_nosides_dead">
    <option name="--set">solver</option>
    <option>qsr_nosides_dead</option>
  </rundefinition>

  <rundefinition name="qsr_nosides_dead_w">
    <option name="--set">solver</option>
    <option>qsr_nosides_dead_w</option>
  </rundefinition>

  <rundefinition name="qso_cwnw">
    <option name="--set">solver</option>
    <option>qso_cwnw</option>
  </rundefinition>

  <rundefinition name="qso_cwnw_w">
    <option name="--set">solver</option>
    <option>qso_cwnw_w</option>
  </rundefinition>

  <tasks name="no-data-race">
    <includesfile>../Pthread.set</includesfile>
    <includesfile>../SvComp-Pthread.set</includesfile>
    <includesfile>../concrat/Concrat.set</includesfile>
    <propertyfile>../concrat/properties/no-data-race.prp</propertyfile>
  </tasks>
</benchmark>
